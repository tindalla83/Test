# Anthropic API key used to call Claude for house-type valuations.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for valuations.
# Defaults to a current Sonnet-class model if unset — see server.js.
MODEL=claude-sonnet-5

# Optional: port the server listens on. Defaults to 3000.
PORT=3000
