# ---------------------------------------------------------------------------
# House Type Valuer — SaaS configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
PORT=4000
# Public base URL of this deployment (used for Stripe redirects & invite links).
APP_URL=http://localhost:4000
NODE_ENV=development

# Secret used to sign session cookies. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives (mounted volume in production).
DATA_DIR=./data

# Anthropic (you pay; billed on to customers via the subscription) -----------
ANTHROPIC_API_KEY=
# Model used for valuations. Sonnet balances quality vs per-run cost.
MODEL=claude-sonnet-5

# Platform admins — comma-separated emails that get the owner-of-the-SaaS
# admin dashboard (revenue, customers, usage). These are YOU, not customers.
PLATFORM_ADMIN_EMAILS=

# Stripe ---------------------------------------------------------------------
# From https://dashboard.stripe.com/apikeys (use test keys in development).
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Price IDs for each paid plan (create Products/Prices in Stripe first).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Optional: a publishable key if you later add Stripe.js on the client.
STRIPE_PUBLISHABLE_KEY=
